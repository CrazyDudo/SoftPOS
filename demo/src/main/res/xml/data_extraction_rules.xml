<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!--
        The transaction database holds card-derived data. Excluding it from cloud backup and from
        device-to-device transfer keeps it on the device that captured it.
    -->
    <cloud-backup>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
