# Normalise to LF in the repository; Git restores platform endings on checkout.
* text=auto eol=lf

# gradlew is executed by sh - CRLF would break it on Linux and macOS.
gradlew text eol=lf
*.sh text eol=lf

# Source is text even if a stray control byte gets in. Without this, one NUL anywhere in a file
# makes git call the whole thing binary, and it then shows no diff and no blame for it - which is
# how a raw NUL sat unnoticed inside a char literal in Pan.kt and Track2Data.kt until v0.1.1.
*.kt text diff=java
*.kts text diff=java

# Windows scripts must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Never touch these.
*.jar binary
*.apk binary
*.aab binary
*.keystore binary
*.png binary
*.jpg binary
*.webp binary
